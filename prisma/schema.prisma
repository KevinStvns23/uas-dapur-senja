generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Menu {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  price       Int
  rating      Float
  image       String
  desc        String
  ingredients String
  createdAt   DateTime @default(now())
}
